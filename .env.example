# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/ys-commerce?schema=public"

# Auth.js signing secret — generate per environment:
#   openssl rand -base64 32
AUTH_SECRET=""

# Key used to seal chat message bodies at rest. Set this EXPLICITLY in
# production: rotating it makes existing messages unreadable.
MESSAGE_ENCRYPTION_KEY=""

# Demo admin created by `npm run db:seed`. Dev only — rotate or remove.
ADMIN_EMAIL="admin@ys.local"
ADMIN_PASSWORD=""

# Hosts allowed for product/store/site images, comma-separated. `next/image`
# throws at render for any host missing from this list, so sellers cannot paste
# arbitrary URLs. picsum.photos is always allowed so a fresh seed works.
# Example: IMAGE_HOSTS="my-bucket.r2.cloudflarestorage.com,cdn.example.com"
IMAGE_HOSTS=""

# Absolute origin used by sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Behind a proxy / non-localhost host, Auth.js v5 rejects requests with
# "UntrustedHost". Set this to true when deploying.
AUTH_TRUST_HOST="false"

# Where chat uploads are written. Defaults to public/uploads/chat.
# UPLOAD_DIR=""

# Shopping-assistant LLM (optional). The admin console `AI Assistant` tab can
# also store these; env wins when both are set.
# Hugging Face free tier: fine-grained token with Inference Providers
# permission → https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=""
# Google AI Studio (Gemini): API key → https://aistudio.google.com (Get API key)
# GOOGLE_AI_API_KEY=""
