// ys-commerce marketplace schema.
// Managed by Prisma. Apply with: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// Custom staff roles (e.g. Support, Finance). A user's effective scopes =
// role scopes + staff-role scopes + per-user overrides. ADMIN always has "*".
model StaffRole {
  id        String   @id @default(cuid())
  name      String   @unique
  scopes    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

enum StoreStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  TAKEDOWN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  role         Role      @default(BUYER)
  // Staff-ready: roles stay in the enum; per-area scopes (when needed)
  // attach here without touching every guard (see lib/auth/permissions).
  scopes       String[]  @default([])
  staffRoleId  String?
  staffRole    StaffRole? @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  // Buyer lifecycle preferences, e.g. { lifecycle: false, priceAlerts: false }.
  prefs        Json?
  suspendedAt  DateTime?
  suspendReason String?
  image        String?
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  stores    Store[]    @relation("StoreOwner")
  reviews   Review[]
  disputes  Dispute[]  @relation("DisputeBuyer")
  returns   ReturnRequest[] @relation("ReturnBuyer")
  auditLogs AuditLog[] @relation("AuditActor")
  apiTokens ApiToken[]
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Store {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String?
  logo           String?
  banner         String?
  shippingPolicy String?
  returnPolicy   String?
  announcement   String?
  status         StoreStatus @default(PENDING)
  commissionRate Decimal     @default(0.05) @db.Decimal(5, 4)
  ratingAvg      Float       @default(0)
  ratingCount    Int         @default(0)
  soldCount      Int         @default(0)
  followerCount  Int         @default(0)
  ownerId        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  owner    User      @relation("StoreOwner", fields: [ownerId], references: [id])
  products Product[]
  payouts  Payout[]
  reviews  Review[]
  followers StoreFollow[]
  shipments Shipment[]
  returns  ReturnRequest[]

  @@index([status])
  @@index([ratingAvg])
}

model StoreFollow {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  targetPrice Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

enum AlertKind {
  PRICE_DROP
  RESTOCK
}

// Queued buyer alerts (price targets, restock). sentAt = delivered once.
model PriceAlert {
  id        String    @id @default(cuid())
  userId    String
  productId String
  kind      AlertKind
  target    Decimal?  @db.Decimal(10, 2)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([productId, kind, sentAt])
}

enum DealStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

// Admin-curated flash deals: one row per product, effective while ACTIVE
// (window open + cap unmet). Pricing resolves via lib/deals/pricing.
model Deal {
  id        String     @id @default(cuid())
  productId String     @unique
  dealPrice Decimal    @db.Decimal(10, 2)
  startsAt  DateTime
  endsAt    DateTime
  stockCap  Int?
  soldCount Int        @default(0)
  status    DealStatus @default(SCHEDULED)
  createdAt DateTime   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, startsAt])
  @@index([status, endsAt])
}

// Latest cart per signed-in buyer (written by the storefront) for
// abandoned-cart recovery. Guests are never tracked.
model CartSnapshot {
  userId    String   @id
  items     Json
  updatedAt DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  // Weighted tsvector backing the GIN index the search engine ranks against.
  // Created as a GENERATED ALWAYS STORED column by the search_fts migration;
  // Prisma can't model generated columns, so declaring it here is what stops
  // `migrate dev` from proposing to DROP the live full-text index. Never write
  // to it directly — Postgres maintains it from title/category/description.
  search      Unsupported("tsvector")?
  description String?
  image       String
  images      String[]      @default([])
  specs       Json?
  price       Decimal       @db.Decimal(10, 2)
  compareAt   Decimal?      @db.Decimal(10, 2)
  category    String
  badge       String?
  freeShipping Boolean      @default(true)
  status      ProductStatus @default(ACTIVE)
  ratingAvg   Float         @default(0)
  ratingCount Int           @default(0)
  soldCount   Int           @default(0)
  storeId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store    Store            @relation(fields: [storeId], references: [id])
  variants ProductVariant[]
  items    OrderItem[]
  reviews  Review[]
  wishlistItems WishlistItem[]
  priceAlerts PriceAlert[]
  deals    Deal[]

  @@index([category])
  @@index([status])
  @@index([ratingAvg])
  @@index([soldCount])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String?  @unique
  price     Decimal? @db.Decimal(10, 2)
  image     String?
  stock     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id        String      @id @default(cuid())
  number    String      @unique
  buyerId   String
  status    OrderStatus @default(PENDING)
  subtotal  Decimal     @db.Decimal(10, 2)
  // Sum of all shipment costs. A multi-seller basket is split into one
  // Shipment per store; there is no single carrier/tracking on the order
  // itself, because there is no single parcel.
  shipping  Decimal     @default(0) @db.Decimal(10, 2)
  discount  Decimal     @default(0) @db.Decimal(10, 2)
  couponCode String?
  total     Decimal     @db.Decimal(10, 2)
  currency  String      @default("USD")
  shipName  String?
  shipPhone String?
  shipStreet String?
  shipCity  String?
  shipZip   String?
  // Buyer-protection deadline. Starts when the LAST parcel is delivered.
  protectionUntil DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items     OrderItem[]
  shipments Shipment[]
  disputes  Dispute[]
  returns   ReturnRequest[]
  events    OrderEvent[]
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

// One parcel per store per order. Tracking, delivery and the order's aggregate
// status are all derived from these rows — the order carries no tracking of
// its own.
model Shipment {
  id        String         @id @default(cuid())
  orderId   String
  storeId   String
  status    ShipmentStatus @default(PENDING)
  shippingCost Decimal      @default(0) @db.Decimal(10, 2)
  carrier   String?
  trackingNumber String?
  shippedAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store   Store       @relation(fields: [storeId], references: [id])
  items   OrderItem[]
  returns ReturnRequest[]

  // One parcel per store per order.
  @@unique([orderId, storeId])
  @@index([storeId, status])
  @@index([status, createdAt])
}

enum OrderEventType {
  CREATED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  NOTE
}

// Status timeline + internal notes, visible to buyer/seller/admin.
model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  type      OrderEventType
  message   String?
  actorId   String?
  createdAt DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  storeId   String
  // Which parcel this line ships in.
  shipmentId String?
  title     String
  image     String
  price     Decimal @db.Decimal(10, 2)
  qty       Int
  variant   String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  product  Product   @relation(fields: [productId], references: [id])

  @@index([shipmentId])
  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Returns / RMA
//
// Deliberately separate from Dispute: a dispute is adversarial and freezes the
// seller's escrow. A return is a buyer exercising ordinary after-sales rights
// ("I want my money back"), and forcing that through Dispute inflates dispute
// rates and freezes escrow for a non-accusatory request.
// ---------------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  ACCEPTED
  RECEIVED
  REFUNDED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  NOT_AS_DESCRIBED
  DEFECTIVE
  WRONG_ITEM
  NO_LONGER_NEEDED
  BETTER_PRICE_ELSEWHERE
  DAMAGED_IN_TRANSIT
  OTHER
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  buyerId   String
  storeId   String
  shipmentId String?
  status    ReturnStatus @default(REQUESTED)
  reason    ReturnReason
  note      String?
  // [{ orderItemId, qty, price }] — a partial return is normal.
  items     Json
  refundAmount Decimal?   @db.Decimal(10, 2)
  sellerNote String?
  resolvedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  buyer    User      @relation("ReturnBuyer", fields: [buyerId], references: [id])
  store    Store     @relation(fields: [storeId], references: [id])
  messages ReturnMessage[]

  @@index([orderId])
  @@index([storeId, status])
  @@index([buyerId, createdAt])
}

model ReturnMessage {
  id        String   @id @default(cuid())
  returnId  String
  author    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Dispute {
  id        String        @id @default(cuid())
  orderId   String
  buyerId   String
  category  DisputeCategory @default(OTHER)
  reason    String
  status    DisputeStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  buyer    User             @relation("DisputeBuyer", fields: [buyerId], references: [id])
  messages DisputeMessage[]

  @@index([orderId])
  @@index([status, createdAt])
}

enum DisputeCategory {
  NOT_RECEIVED
  DAMAGED
  WRONG_ITEM
  QUALITY
  NOT_AS_DESCRIBED
  OTHER
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  author    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType @default(PERCENT)
  pctOff      Int?       // PERCENT: 1-90
  amountOff   Decimal?   @db.Decimal(10, 2) // FIXED: USD off eligible subtotal
  active      Boolean    @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  minSubtotal Decimal?   @db.Decimal(10, 2)
  maxUses     Int?       // total redemption cap
  usedCount   Int        @default(0)
  perUserLimit Int?      // redemptions per user
  categories  String[]   @default([]) // empty = all categories
  storeIds    String[]   @default([]) // empty = all stores
  createdAt   DateTime   @default(now())

  redemptions CouponRedemption[]
}

enum CouponType {
  PERCENT
  FIXED
  FREESHIP
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?  @unique // one coupon per order
  amount    Decimal  @db.Decimal(10, 2) // discount granted (0 for free-ship)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model Payout {
  id        String       @id @default(cuid())
  storeId   String
  amount    Decimal      @db.Decimal(10, 2)
  currency  String       @default("USD")
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())

  store Store @relation(fields: [storeId], references: [id])
}

enum EscrowStatus {
  HELD
  FROZEN
  RELEASED
  REFUNDED
}

// Buyer-protection ledger: every paid order line locks the seller's net
// (gross minus commission) until delivery + protection window, dispute
// freeze, ruling settlement, or refund.
model EscrowHold {
  id        String       @id @default(cuid())
  orderId   String
  orderItemId String    @unique
  storeId   String
  gross     Decimal      @db.Decimal(10, 2)
  commission Decimal     @db.Decimal(10, 2)
  net       Decimal      @db.Decimal(10, 2)
  status    EscrowStatus @default(HELD)
  releasedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([orderId])
  @@index([storeId, status])
  @@index([status, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  storeId   String
  authorId  String
  rating    Int
  title     String?
  body      String?
  images    String[] @default([])
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  replyBody String?
  replyAt   DateTime?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
  votes   ReviewVote[]

  @@unique([productId, authorId])
  @@index([productId, createdAt])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model ApiToken {
  id        String    @id @default(cuid())
  name      String
  tokenHash String    @unique
  userId    String
  scopes    String[]  @default(["admin"])
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

// Site + system configuration. One row per namespaced group, JSON value.
// Read live by the storefront (public subset) and ys-admin (full).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum EmailStatus {
  SENT
  SKIPPED
  FAILED
}

// In-app inbox. Admin console only (bell + /ys-admin/notifications).
// type examples: order.cancelled, dispute.updated, vendor.approved,
// product.takedown, seller.request, dispute.opened, stock.low,
// payout.failed, review.new
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  meta      Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Audit trail of every outbound email (see /ys-admin/emails).
model EmailLog {
  id        String      @id @default(cuid())
  to        String
  template  String
  subject   String
  status    EmailStatus @default(SENT)
  resendId  String?
  error     String?
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}

enum ConversationType {
  ORDER
  INQUIRY
}

// Buyer↔seller conversations. The server stores ciphertext only —
// message bodies are end-to-end encrypted (see lib/chat/e2ee.ts) and
// unreadable to admins, digests, and email.
model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  orderId       String?
  productId     String?
  storeId       String
  buyerId       String
  sellerId      String
  subject       String?
  lastMessageAt DateTime         @default(now())
  blockedById   String?
  reportedAt    DateTime?
  reportReason  String?
  createdAt     DateTime         @default(now())

  messages  ChatMessage[]
  reads     ConversationRead[]

  @@unique([orderId, storeId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@index([storeId])
}

model ConversationRead {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  // Server-sealed AES-GCM blob (see lib/chat/server-crypto.ts). The
  // platform opens rows for delivery, moderation, and dispute review.
  ciphertext     String
  nonce          String
  keyId          String   @default("1")
  replyToId      String?
  imageUrl       String?
  // Auto-screening hits (profanity etc.) — readable, not blocking.
  flagged        Boolean  @default(false)
  flaggedKinds   String[] @default([])
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([flagged, createdAt])
}


// Storefront search analytics: what buyers looked for, what it returned.
// Powers suggestions + (later) a merchandising view. PII-free.
model SearchLog {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  userId    String?
  createdAt DateTime @default(now())

  @@index([query])
  @@index([createdAt])
}
